APP_NAME=PHPeitor
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Lima
APP_URL=http://127.0.0.1:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQL Server de prueba. Reemplaza estos valores con los de tu entorno.
DB_CONNECTION=sqlsrv
DB_HOST=127.0.0.1
DB_PORT=1433
DB_DATABASE=BD_FILAMENT
DB_USERNAME=sa
DB_PASSWORD="cambia-esta-clave"
DB_CHARSET=utf8
DB_ENCRYPT=no
DB_TRUST_SERVER_CERTIFICATE=true

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# `sync` permite probar correos localmente sin ejecutar un worker de colas.
# En producción usa `database` o `redis` y ejecuta `php artisan queue:work`.
QUEUE_CONNECTION=sync

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Para desarrollo sin servidor SMTP, conserva `log` y revisa storage/logs/laravel.log.
# Para probar recuperación de contraseña y verificación por correo, cambia a smtp
# y reemplaza todos los valores de ejemplo.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_ENCRYPTION=null
MAIL_HOST=smtp.example.test
MAIL_PORT=465
MAIL_USERNAME=usuario@example.test
MAIL_PASSWORD="cambia-esta-clave"
MAIL_FROM_ADDRESS=usuario@example.test
MAIL_FROM_NAME="${APP_NAME}"
MAIL_EHLO_DOMAIN=example.test

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
